# Spotify application client ID, from https://developer.spotify.com/dashboard
# Public by design: the browser app uses Authorization Code with PKCE and holds no secret.
VITE_SPOTIFY_CLIENT_ID=

# Must match the dashboard's Redirect URI byte for byte, including the trailing
# slash (or its absence). Optional — defaults to http://127.0.0.1:5173/
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/

# Used ONLY by scripts/validate-decks.ts (Client Credentials flow), never shipped to
# the browser. Note the missing VITE_ prefix — that is what keeps it out of the bundle.
SPOTIFY_CLIENT_SECRET=
